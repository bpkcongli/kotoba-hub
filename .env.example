# Browser mocks are enabled only by the development runtime.
NEXT_PUBLIC_API_MOCKING=false

# Local Docker Compose MySQL only. Replace credentials outside local development.
MYSQL_DATABASE=kotoba_hub
MYSQL_USER=kotoba
MYSQL_PASSWORD=kotoba_local
MYSQL_ROOT_PASSWORD=kotoba_root_local
DATABASE_URL=mysql://kotoba:kotoba_local@127.0.0.1:3306/kotoba_hub

# Authentication and AI env validation are introduced with their backend tasks.
