{
  "name": "kotoba-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=20.19.0",
    "bun": "1.3.9"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:changed": "jest --onlyChanged --passWithNoTests",
    "test:ci": "jest --ci --runInBand",
    "test:auth-adapter": "bun scripts/smoke-auth-adapter.ts",
    "test:syllabus-importer": "bun scripts/smoke-syllabus-importer.ts",
    "test:progress": "bun scripts/smoke-progress.ts",
    "test:flashcards": "bun scripts/smoke-flashcards.ts",
    "test:ai": "bun scripts/smoke-ai.ts",
    "test:practice": "bun scripts/smoke-practice.ts",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run test:ci",
    "prepare": "husky",
    "mocks:init": "msw init public --save",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:syllabus": "bun scripts/seed-syllabus.ts",
    "db:seed:syllabus:dry-run": "bun scripts/seed-syllabus.ts --dry-run",
    "db:seed:flashcards": "bun scripts/seed-flashcards.ts",
    "db:seed:flashcards:dry-run": "bun scripts/seed-flashcards.ts --dry-run"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@radix-ui/react-slot": "1.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "inversify": "8.2.3",
    "lucide-react": "1.52.0",
    "mobx": "7.0.6",
    "mobx-react-lite": "5.1.0",
    "mysql2": "3.24.5",
    "next": "16.1.7",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5",
    "eslint-plugin-react": "7.37.5",
    "husky": "9.1.7",
    "jest": "30",
    "jest-environment-jsdom": "30",
    "lint-staged": "16",
    "msw": "2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.3",
    "tailwindcss": "4",
    "typescript": "5"
  }
}
