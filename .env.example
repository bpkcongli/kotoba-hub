# Browser mocks are enabled only by the development runtime.
NEXT_PUBLIC_API_MOCKING=false

# Local Docker Compose MySQL only. Replace credentials outside local development.
MYSQL_DATABASE=kotoba_hub
MYSQL_USER=kotoba
MYSQL_PASSWORD=kotoba_local
MYSQL_ROOT_PASSWORD=kotoba_root_local
DATABASE_URL=mysql://kotoba:kotoba_local@127.0.0.1:3306/kotoba_hub

# Google OAuth callback URI: http://localhost:3000/api/v1/auth/callback/google
# Server-only canonical origin, also used by Auth.js. Keep the auth path in code.
# Set the deployed HTTPS origin in production, for example https://kotobahub.example.com.
AUTH_URL=http://localhost:3000

# Generate a private secret of at least 32 characters; do not commit its value.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-only AI settings. API billing is separate from ChatGPT Plus.
# A missing key is allowed until an AI operation is invoked.
AI_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.6-terra
OPENAI_NORMALIZATION_MODEL=gpt-5.6-luna
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_RETRY_DELAY_MS=250
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_INPUT_CHARS=40000
