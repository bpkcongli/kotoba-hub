{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotobahub.local/docs/syllabus/schema/seed-manifest.v2.schema.json",
  "title": "KotobaHub bilingual syllabus batch manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "defaultLocale",
    "supportedLocales",
    "importMode",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "defaultLocale": {
      "const": "en"
    },
    "supportedLocales": {
      "const": ["en", "id"]
    },
    "importMode": {
      "const": "MERGE_LESSONS"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "curriculumLevel", "file", "sortOrder", "isPublished", "lessonIds"],
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "jlpt-n5-foundation",
              "jlpt-n4-expansion",
              "jlpt-n3-bridge",
              "jlpt-n2-advanced"
            ],
            "maxLength": 100
          },
          "curriculumLevel": {
            "type": "string",
            "enum": ["N5", "N4", "N3", "N2"]
          },
          "file": {
            "type": "string",
            "pattern": "^tracks/[a-z0-9-]+\\.json$"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 1
          },
          "isPublished": {
            "type": "boolean"
          },
          "lessonIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 4
    }
  }
}
