# Copy app/ops refs from one successful publish run's release-metadata.json.
APP_IMAGE=docker.io/REPLACE_WITH_NAMESPACE/kotoba-hub@REPLACE_WITH_APP_DIGEST
OPS_IMAGE=docker.io/REPLACE_WITH_NAMESPACE/kotoba-hub@REPLACE_WITH_OPS_DIGEST
# Pin the verified official MySQL 8.4 digest separately from application releases.
MYSQL_IMAGE=docker.io/library/mysql:8.4@REPLACE_WITH_MYSQL_DIGEST
