{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "kind": {
      "type": "string",
      "const": "STANDALONE_VOCABULARY_GROUPS"
    },
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "code": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9-]+$"
          },
          "trackSlug": {
            "type": "string",
            "minLength": 1
          },
          "curriculumLevel": {
            "type": "string",
            "enum": [
              "N5",
              "N4"
            ]
          },
          "sortOrder": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "contentRevision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "isPublished": {
            "type": "boolean"
          },
          "sourceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "pendingSkillCode": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "itemId",
                "pendingSkillCode"
              ],
              "additionalProperties": false
            }
          },
          "localizations": {
            "type": "object",
            "properties": {
              "en": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourceRevision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "translationRevision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "isPublished": {
                    "type": "boolean"
                  },
                  "sourceRefs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "title",
                  "description",
                  "sourceRevision",
                  "translationRevision",
                  "isPublished",
                  "sourceRefs"
                ],
                "additionalProperties": false
              },
              "id": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourceRevision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "translationRevision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "isPublished": {
                    "type": "boolean"
                  },
                  "sourceRefs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "title",
                  "description",
                  "sourceRevision",
                  "translationRevision",
                  "isPublished",
                  "sourceRefs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "code",
          "slug",
          "trackSlug",
          "curriculumLevel",
          "sortOrder",
          "contentRevision",
          "isPublished",
          "sourceRefs",
          "items",
          "localizations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "groups"
  ],
  "additionalProperties": false
}
